# ── App ────────────────────────────────────────────────────────────────────────
# NODE_ENV: "development" | "production" | "test"
NODE_ENV=development

# PORT: HTTP port the Fastify server listens on
PORT=3000

# ── Database ────────────────────────────────────────────────────────────────────
# DATABASE_URL: Full PostgreSQL connection string (docker-compose default below)
# NOTE: Docker runs on port 5433 (local postgres may occupy 5432)
DATABASE_URL=postgresql://eclean:eclean_dev@localhost:5433/eclean_dev

# ── Redis ────────────────────────────────────────────────────────────────────────
# REDIS_URL: Redis connection string — used by BullMQ job queues and caching
REDIS_URL=redis://localhost:6379

# ── Auth ────────────────────────────────────────────────────────────────────────
# JWT_ACCESS_SECRET: Signs access tokens (15m). Min 32 chars. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=REPLACE_THIS_min_32_chars_generate_with_openssl_rand_-base64_48

# JWT_REFRESH_SECRET: Signs refresh tokens (7d). MUST differ from access secret.
JWT_REFRESH_SECRET=REPLACE_THIS_min_32_chars_generate_with_openssl_rand_-base64_48

# BCRYPT_ROUNDS: Password hashing cost factor. 12 = ~250ms/hash (good for prod)
BCRYPT_ROUNDS=12

# ── Cloudinary (photo uploads) ──────────────────────────────────────────────────
# Get these from: https://cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── AI Verification ─────────────────────────────────────────────────────────────
# Anthropic (Claude Vision) — fallback AI provider
ANTHROPIC_API_KEY=
# OpenAI (gpt-4.1) — primary AI provider for photo verification
OPENAI_API_KEY=

# ── Razorpay (payments & payouts) ───────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys
# Set RAZORPAY_KEY_ID=test_mode to skip real API calls during development
RAZORPAY_KEY_ID=test_mode
RAZORPAY_KEY_SECRET=
# Webhook secret: https://dashboard.razorpay.com → Settings → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=
# RazorpayX current account number (for worker payouts)
# Get from: https://x.razorpay.com → Account & Settings → Account Details
RAZORPAY_ACCOUNT_NUMBER=

# ── Email (Resend) ──────────────────────────────────────────────────────────────
# Get from: https://resend.com → API Keys
RESEND_API_KEY=

# ── Push Notifications ──────────────────────────────────────────────────────────
# Uses Expo Push API — no key needed. Device tokens registered via app.
# Legacy Firebase field (unused):
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── CI/CD ───────────────────────────────────────────────────────────────────────
# Protects /api/v1/ci/seed endpoint. Set in GitHub Secrets.
CI_SECRET=

# ── CORS & URLs ─────────────────────────────────────────────────────────────────
# CORS_ORIGINS: Comma-separated list of allowed frontend origins (tightened in production)
CORS_ORIGINS=http://localhost:3001

# FRONTEND_URL: Used for redirect links in emails (deep link for mobile: eclean://)
FRONTEND_URL=http://localhost:3001

# ── Monitoring ───────────────────────────────────────────────────────────────────
# SENTRY_DSN: Get from https://sentry.io → Project → Settings → Client Keys
SENTRY_DSN=
